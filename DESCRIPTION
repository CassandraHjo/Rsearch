Type: Package
Package: Rsearch
Title: Processing and Analyzing Amplicon Sequence Data
Version: 1.2.0
Authors@R: c(
    person("Cassandra", "Stamsaas", , "cassandra.stamsaas@nmbu.no", role = c("cre", "aut")),
    person("Lars", "Snipen", , "lars.snipen@nmbu.no", role = "aut"),
    person("Torbjørn", "Rognes", , "torognes@ifi.uio.no", role = "aut"),
